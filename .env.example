# ─── BizNavigate Backend — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your actual values before deploying.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
API_PREFIX=api
API_URL=https://your-domain.com

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=https://your-frontend.com,https://app.your-domain.com
CORS_ORIGIN=https://your-frontend.com

# WebSocket URL (usually same as API_URL)
WS_URL=wss://your-domain.com

# ── PostgreSQL (via Prisma) ───────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@your-rds-endpoint:5432/biznavigate?schema=public"

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Format: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/biznavigate"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST="your-redis-host"
REDIS_PORT=6379
REDIS_PASSWORD="yourredispassword"
REDIS_DB=0
# Set to "true" if using Redis Cluster mode (e.g. ElastiCache Cluster Mode)
REDIS_CLUSTER=false
# Only if REDIS_CLUSTER=true — comma-separated host:port pairs
# REDIS_NODES=node1:6379,node2:6379

# ── Kafka ─────────────────────────────────────────────────────────────────────
# When running via docker-compose on EC2, this is auto-overridden to kafka:29092
# Leave as localhost for local development
KAFKA_BROKERS=localhost:9093

# ── JWT / Auth ────────────────────────────────────────────────────────────────
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Symmetric encryption key for sensitive data (32+ chars recommended)
ENCRYPTION_KEY="your-32-character-encryption-key"

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"

# ── Cloudflare R2 Storage (if used instead of S3) ─────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"
R2_PUBLIC_URL="https://your-custom-domain-or-pub-url.r2.dev"

# ── Facebook / Instagram ──────────────────────────────────────────────────────
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_WEBHOOK_VERIFY_TOKEN="your-random-webhook-verify-token"
INSTAGRAM_API_VERSION="v19.0"
INSTAGRAM_OAUTH_REDIRECT_URI="https://your-domain.com/api/instagram/callback"

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-waba-id"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# ── Gupshup ──────────────────────────────────────────────────────────────────
GUPSHUP_EMAIL="your-gupshup-partner-email"
GUPSHUP_PASSWORD="your-gupshup-partner-password"
# Master Gupshup app ID (your platform's app, used for startup webhook subscription)
GUPSHUP_APP_ID="your-gupshup-app-id"
# Joint Solution ID generated by Meta when you create a partner solution with Gupshup
# Required for Tech Partner (TPP) Hosted Embedded Signup flow
GUPSHUP_SOLUTION_ID="your-joint-solution-id-from-meta"


# ── AI / LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY="your-openai-api-key"
# Optional: point to an OpenAI-compatible gateway/provider. Leave empty for OpenAI.
# OPENAI_BASE_URL="https://api.openai.com/v1"
# Agent model roles. Keep primary strong for booking/tool decisions; use fast for triage/acks.
AI_PRIMARY_MODEL="gpt-4o"
AI_FAST_MODEL="gpt-4o-mini"
AI_TOOL_FALLBACK_MODEL="gpt-4o-mini"
AI_SUMMARY_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
GEMINI_API_KEY="your-gemini-api-key"
# LLM_SERVICE_URL=http://localhost:5000
# RAG_SERVICE_URL=http://localhost:5001
