model hotel_booking_outcomes {
  id                String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id String                        @db.Uuid
  hotel_id          String                        @db.VarChar(50)
  org_id            String                        @db.VarChar(255)
  actual_price_used Int
