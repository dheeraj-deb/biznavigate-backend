  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  business_workflows  business_workflows[]
  workflow_executions workflow_executions[]

  @@unique([business_type, intent_name], map: "unique_business_type_intent")
  @@index([business_type], map: "idx_workflow_definitions_business_type")
  @@index([intent_name], map: "idx_workflow_definitions_intent")
  @@index([is_active], map: "idx_workflow_definitions_active")
}

/// Business Workflows - Workflows assigned to each business
model business_workflows {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id          String               @db.Uuid
  tenant_id            String               @db.Uuid
  intent_name          String               @db.VarChar(100)
  workflow_id          String               @db.Uuid
  is_active            Boolean              @default(true)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  businesses           businesses           @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  tenants              tenants              @relation(fields: [tenant_id], references: [tenant_id])
  workflow_definitions workflow_definitions @relation(fields: [workflow_id], references: [workflow_id])

  @@unique([business_id, intent_name], map: "unique_business_intent")
  @@index([business_id], map: "idx_business_workflows_business_id")
  @@index([intent_name], map: "idx_business_workflows_intent")
  @@index([workflow_id], map: "idx_business_workflows_workflow_id")
}

model workflow_executions {
  execution_id         String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id          String               @db.Uuid
  business_id          String               @db.Uuid
  lead_id              String               @db.Uuid
  status               String               @db.VarChar(50)
  started_at           DateTime             @default(now()) @db.Timestamptz(6)
  completed_at         DateTime?            @db.Timestamptz(6)
  created_at           DateTime             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime             @default(now()) @db.Timestamptz(6)
  current_node_id      String?              @db.VarChar(100)
  waiting_for_input    Boolean              @default(false)
  channel              String?              @db.VarChar(50)
  context              Json?
  intent               String?              @db.VarChar(100)
  message_id           String?              @db.VarChar(255)
  chat_id              String?              @db.VarChar(255)
  businesses           businesses           @relation(fields: [business_id], references: [business_id])
  leads                leads                @relation(fields: [lead_id], references: [lead_id])
  workflow_definitions workflow_definitions @relation(fields: [workflow_id], references: [workflow_id])

  @@index([business_id], map: "idx_workflow_executions_business_id")
  @@index([lead_id], map: "idx_workflow_executions_lead_id")
  @@index([started_at(sort: Desc)], map: "idx_workflow_executions_started_at")
  @@index([status], map: "idx_workflow_executions_status")
  @@index([workflow_id], map: "idx_workflow_executions_workflow_id")
}

