// ─── Hotel Pricing Engine ────────────────────────────────────────────────────

model hotel_pricing_recommendations {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id             String                   @db.VarChar(50)
  org_id               String                   @db.VarChar(255)
  room_type            String                   @db.VarChar(100)
  checkin_date         DateTime                 @db.Date
  suggested_price      Int
  demand_score         Float
  confidence           Float
  competitor_avg_price Int
  current_price        Int
  price_range_low      Int
  price_range_high     Int
  claude_narrative     String?
  xotelo_snapshot      Json?
  seven_day_forecast   Json?
  created_at           DateTime                 @default(now()) @db.Timestamptz(6)
  booking_outcomes     hotel_booking_outcomes[]

  @@index([hotel_id, checkin_date])
  @@index([org_id])
