  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([business_id, status], map: "idx_seller_owner_approvals_business_status")
  @@index([business_id, created_at(sort: Desc)], map: "idx_seller_owner_approvals_business_created")
  @@index([tenant_id], map: "idx_seller_owner_approvals_tenant_id")
}

/// Product seller stock holds created by AI, owner, or counter staff
model seller_stock_reservations {
  seller_reservation_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id           String    @db.Uuid
  tenant_id             String    @db.Uuid
  product_id            String    @db.Uuid
  variant_id            String?   @db.Uuid
  lead_id               String?   @db.Uuid
  customer_id           String?   @db.Uuid
  customer_phone        String?   @db.VarChar(20)
