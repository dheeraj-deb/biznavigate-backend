/// Product seller payment attempts for retry-safe order payment handling
model seller_order_payment_attempts {
  attempt_id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id         String    @db.Uuid
  tenant_id           String    @db.Uuid
  order_id            String    @db.Uuid
  reservation_id      String?   @db.Uuid
  payment_provider    String    @default("manual") @db.VarChar(50)
  payment_method      String    @default("upi") @db.VarChar(50)
  amount              Decimal   @db.Decimal(10, 2)
  currency            String    @default("INR") @db.VarChar(10)
  status              String    @default("pending") @db.VarChar(30)
  idempotency_key     String    @unique @db.VarChar(160)
  provider_order_id   String?   @db.VarChar(255)
  provider_payment_id String?   @db.VarChar(255)
  payment_reference   String?   @db.VarChar(255)
  expires_at          DateTime? @db.Timestamptz(6)
  paid_at             DateTime? @db.Timestamptz(6)
  failed_at           DateTime? @db.Timestamptz(6)
  cancelled_at        DateTime? @db.Timestamptz(6)
  source              String    @default("payment_desk") @db.VarChar(50)
  created_by          String?   @db.Uuid
  metadata            Json?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  @@index([business_id, status, created_at(sort: Desc)], map: "idx_seller_payment_attempts_business_status")
  @@index([order_id, status], map: "idx_seller_payment_attempts_order_status")
  @@index([provider_payment_id], map: "idx_seller_payment_attempts_provider_payment")
  @@index([tenant_id], map: "idx_seller_payment_attempts_tenant")
