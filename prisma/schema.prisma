  risk_level       String    @default("low") @db.VarChar(20)
  status           String    @default("pending") @db.VarChar(20)
  source           String    @default("ai") @db.VarChar(30)
  ai_employee_key  String?   @db.VarChar(80)
  customer_phone   String?   @db.VarChar(20)
