  type           String   @db.VarChar(10)
  amount         Decimal  @db.Decimal(12, 2)
  balance_before Decimal  @db.Decimal(12, 2)
  balance_after  Decimal  @db.Decimal(12, 2)
  description    String   @db.VarChar(255)
  reference_id   String?  @db.VarChar(100)
  reference_type String?  @db.VarChar(50)
  action_type    String?  @db.VarChar(50)
  status         String   @default("completed") @db.VarChar(20)
  metadata       Json?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  wallet         wallets  @relation(fields: [wallet_id], references: [wallet_id])

  @@index([wallet_id, created_at(sort: Desc)])
  @@index([reference_id])
}

model billing_payments {
  payment_id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id         String     @db.Uuid
  razorpay_payment_id String     @unique @db.VarChar(100)
  razorpay_order_id   String?    @db.VarChar(100)
  amount              Int
  type                String     @db.VarChar(30)
  status              String     @db.VarChar(20)
  idempotency_key     String     @unique @db.VarChar(100)
  metadata            Json?
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  businesses          businesses @relation("business_billing_payments", fields: [business_id], references: [business_id])

  @@index([business_id, created_at(sort: Desc)])
}

model billing_invoices {
  invoice_id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id         String                 @db.Uuid
  subscription_id     String?                @db.Uuid
  razorpay_invoice_id String?                @db.VarChar(100)
  subtotal            Int
  tax_amount          Int
  total_amount        Int
  status              String                 @db.VarChar(20)
  pdf_url             String?                @db.VarChar(500)
  due_date            DateTime?              @db.Date
  paid_at             DateTime?              @db.Timestamptz(6)
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  businesses          businesses             @relation("business_billing_invoices", fields: [business_id], references: [business_id])
  subscription        billing_subscriptions? @relation(fields: [subscription_id], references: [subscription_id])

  @@index([business_id, created_at(sort: Desc)])
}

model billing_webhook_events {
  event_id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String    @db.VarChar(30)
  event_type        String    @db.VarChar(100)
  razorpay_event_id String?   @unique @db.VarChar(150)
  payload           Json
  status            String    @default("pending") @db.VarChar(20)
  attempts          Int       @default(0)
  error             String?
  processed_at      DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([status, created_at])
}

model credit_pricing {
  action_type String   @id @db.VarChar(50)
  cost        Decimal  @db.Decimal(8, 4)
  description String   @db.VarChar(255)
  is_active   Boolean  @default(true)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
}

// ─── BUSINESS SETTINGS ────────────────────────────────────────────────────────

model business_settings {
  business_id        String     @id @db.Uuid
  timezone           String     @default("Asia/Kolkata") @db.VarChar(50)
  language           String     @default("en") @db.VarChar(10)
  currency           String     @default("INR") @db.VarChar(10)
  business_hours     Json?
  onboarding_step    Int        @default(0)
  onboarding_done    Boolean    @default(false)
  ai_agent_enabled   Boolean    @default(true)
  auto_reply_enabled Boolean    @default(true)
  booking_methods    Json       @default("{\"availability_response\":{\"mode\":\"interactive\"},\"ai_chat\":{\"enabled\":true,\"collect_guest_details\":true,\"require_confirmation\":true},\"interactive\":{\"enabled\":true,\"send_entry_buttons\":true,\"send_room_or_service_list\":true},\"catalog\":{\"enabled\":false,\"send_product_messages\":false},\"templates\":{\"enabled\":false,\"confirmation_template_name\":\"\",\"reminder_template_name\":\"\",\"language\":\"en\"},\"human_handoff\":{\"enabled\":true,\"on_unavailable\":true,\"on_low_confidence\":true,\"on_payment_issue\":true}}")
  booking_link       Json       @default("{\"enabled\":false,\"experience_type\":\"generic\",\"payment_mode\":\"manual\",\"advance_type\":\"fixed\",\"advance_amount\":0,\"theme\":{\"primary_color\":\"#0066FF\",\"show_logo\":true,\"show_banner\":true},\"policies\":{\"cancellation\":\"\",\"refund\":\"\",\"terms\":\"\"},\"contact\":{\"phone\":\"\",\"whatsapp\":\"\",\"address\":\"\"},\"required_fields\":{\"name\":true,\"phone\":true,\"email\":false,\"address\":false,\"notes\":false}}")
  whatsapp_onboarding Json      @default("{\"current_usage\":\"not_sure\",\"safety_acknowledged\":false}")
  low_balance_alert  Decimal    @default(100) @db.Decimal(10, 2)
  /// E.164-style dial code without the "+" (e.g. "91" for India, "1" for US).
  /// Used to canonicalise leads.phone so the same human entering "9539192684"
  /// on the booking form and messaging "919539192684" on WhatsApp resolves to
  /// one lead row.
  default_country_code String  @default("91") @db.VarChar(5)
  updated_at         DateTime   @default(now()) @db.Timestamptz(6)
  businesses         businesses @relation("business_settings", fields: [business_id], references: [business_id], onDelete: Cascade)
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model audit_logs {
  log_id      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id String     @db.Uuid
  user_id     String?    @db.Uuid
  action      String     @db.VarChar(100)
  entity_type String     @db.VarChar(100)
  entity_id   String?    @db.VarChar(100)
  old_values  Json?
  new_values  Json?
  ip_address  String?    @db.VarChar(45)
  user_agent  String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  businesses  businesses @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  users       users?     @relation(fields: [user_id], references: [user_id])

  @@index([business_id, created_at(sort: Desc)], map: "idx_audit_logs_business_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user_id")
}

/// Tracks which inventory items / catalog items a lead has shown interest in.
/// Used to trigger price-drop and availability alerts (confirmation-first rule).
model lead_item_interests {
  interest_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id         String   @db.Uuid
  business_id     String   @db.Uuid
  /// UUID of the item (vehicle_inventory.vehicle_id, catalog_items.item_id, etc.) — nullable for free-text items
  item_id         String?  @db.Uuid
  /// vehicle | catalog_item | property | course | activity
  item_type       String   @db.VarChar(30)
  item_name       String   @db.VarChar(255)
  /// viewed | price_checked | visit_requested
  interest_level  String   @default("viewed") @db.VarChar(20)
  last_price_seen Decimal? @db.Decimal(12, 2)
  /// true when lead tapped "notify me" — only these leads get campaigns
  is_alert_active Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  leads           leads    @relation(fields: [lead_id], references: [lead_id], onDelete: Cascade)

  @@unique([lead_id, item_id], map: "uq_lead_item_interest")
  @@index([lead_id], map: "idx_lead_item_interests_lead")
  @@index([business_id, is_alert_active], map: "idx_lead_item_interests_business_alert")
}

/// Stores what a lead is watching for when no match exists yet.
/// AI creates this automatically after a failed search if lead opts in.
model lead_preference_watches {
  watch_id    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lead_id     String    @db.Uuid
  business_id String    @db.Uuid
  /// price_range | item_match | date_available | stock_available | batch_available
  watch_type  String    @db.VarChar(30)
  /// JSONB: budget_max, make, model, date_from, date_to, variant, course_id, etc.
  criteria    Json
  is_active   Boolean   @default(true)
  /// Set when campaign is sent — prevents duplicate alerts for same event
  notified_at DateTime? @db.Timestamptz(6)
  /// Auto-expire after 90 days with no match
  expires_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  leads       leads     @relation(fields: [lead_id], references: [lead_id], onDelete: Cascade)

  @@index([business_id, watch_type, is_active], map: "idx_pref_watches_business_type_active")
  @@index([lead_id], map: "idx_pref_watches_lead")
  @@index([expires_at], map: "idx_pref_watches_expires")
}
