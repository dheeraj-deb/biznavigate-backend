/// Product seller order state events for audit and idempotency visibility
model seller_order_state_events {
  event_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id         String   @db.Uuid
  tenant_id           String   @db.Uuid
  order_id            String   @db.Uuid
  event_type          String   @db.VarChar(80)
  from_status         String?  @db.VarChar(30)
  to_status           String?  @db.VarChar(30)
  from_payment_status String?  @db.VarChar(30)
  to_payment_status   String?  @db.VarChar(30)
  actor_type          String   @default("system") @db.VarChar(40)
  actor_id            String?  @db.Uuid
  source              String?  @db.VarChar(50)
  idempotency_key     String?  @unique @db.VarChar(160)
  metadata            Json?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([business_id, created_at(sort: Desc)], map: "idx_seller_order_events_business_created")
  @@index([order_id, created_at(sort: Desc)], map: "idx_seller_order_events_order_created")
  @@index([tenant_id], map: "idx_seller_order_events_tenant")
}

/// Product seller bulk import jobs for CSV/Excel stock onboarding
model seller_product_import_jobs {
  import_job_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id   String    @db.Uuid
