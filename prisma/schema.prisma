/// catalog_items - single table for all sellable items across all business types
/// item_type: "physical_product" | "accommodation" | "activity" | "service" | "vehicle"
model catalog_items {
  item_id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id               String                      @db.Uuid
  tenant_id                 String                      @db.Uuid
  /// "physical_product" | "accommodation" | "activity" | "service"
  item_type                 String                      @db.VarChar(30)
  name                      String                      @db.VarChar(255)
  description               String?
  category                  String?                     @db.VarChar(100)
  base_price                Decimal                     @db.Decimal(10, 2)
  compare_price             Decimal?                    @db.Decimal(10, 2)
  currency                  String                      @default("INR") @db.VarChar(10)
  /// stock count — used for physical_product only (null for accommodation/activity/service)
  stock_quantity            Int?
  primary_image_url         String?                     @db.VarChar(500)
  image_urls                Json?
  /// Type-specific fields stored as JSONB — GIN indexed after migration
  /// accommodation: { capacity, total_units, check_in_time, check_out_time, bed_type, has_ac, has_wifi, has_pool, meal_plan, extra_guest_charge }
  /// activity:      { total_slots, group_size_min, group_size_max, duration_hours, duration_days, difficulty, includes, excludes, location, start_times }
  /// service:       { duration_minutes, concurrent_slots, requires_appointment }
  /// physical_product: { brand, condition, weight, dimensions }
  attributes                Json?
  /// AI-generated tags for chatbot fuzzy search — GIN indexed after migration
  ai_tags                   String[]                    @default([])
  is_active                 Boolean                     @default(true)
  deleted_at                DateTime?                   @db.Timestamptz(6)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  cart_items                cart_items[]
  cart_reservations         cart_reservations[]
  product_detail            product_item_details?
  hospitality_detail        hospitality_item_details?
  vehicle_detail            vehicle_item_details?
  product_order_items       product_order_items[]
  hospitality_booking_items hospitality_booking_items[]
  product_inquiries         product_inquiries[]
  hospitality_inquiries     hospitality_inquiries[]
  businesses                businesses                  @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  availability              item_availability[]
  variants                  item_variants[]
  order_items               order_items[]
  external_catalog_items    external_catalog_items[]

  @@index([business_id, item_type, is_active])
  @@index([business_id, created_at(sort: Desc)])
  @@index([business_id, category, is_active])
}

/// item_variants - size/color/SKU variants for physical_product items only
model item_variants {
  variant_id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id             String                @db.Uuid
  business_id         String                @db.Uuid
  name                String                @db.VarChar(100)
  sku                 String?               @db.VarChar(100)
  price               Decimal               @db.Decimal(10, 2)
  stock_quantity      Int                   @default(0)
  /// e.g. { "color": "Red", "size": "M" } — GIN indexed via attributes on parent
  options             Json?
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  cart_items          cart_items[]
  item                catalog_items         @relation(fields: [item_id], references: [item_id], onDelete: Cascade)
  order_items         order_items[]
  product_order_items product_order_items[]

  @@index([item_id])
  @@index([business_id])
}

/// item_availability - date-based slot availability for accommodation, activity, service items
model item_availability {
  avail_id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id        String        @db.Uuid
  business_id    String        @db.Uuid
  date           DateTime      @db.Date
  total_slots    Int
  booked_slots   Int           @default(0)
  /// date-specific price override (e.g. weekend surge) — null means use base_price
  price_override Decimal?      @db.Decimal(10, 2)
  is_blocked     Boolean       @default(false)
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  item           catalog_items @relation(fields: [item_id], references: [item_id], onDelete: Cascade)

  @@unique([item_id, date])
  @@index([item_id, date])
  @@index([business_id, date])
}

