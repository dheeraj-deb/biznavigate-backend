  xotelo_snapshot      Json?
  seven_day_forecast   Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  booking_outcomes     hotel_booking_outcomes[]

  @@index([hotel_id, checkin_date])
  @@index([org_id])
}

model hotel_booking_outcomes {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recommendation_id String   @db.Uuid
  hotel_id          String   @db.VarChar(50)
  org_id            String   @db.VarChar(255)
  actual_price_used Int
  rooms_booked      Int
  total_rooms       Int
  actual_occupancy  Float
  revenue           Int
  checkin_date      DateTime @db.Date
  recorded_at       DateTime @default(now()) @db.Timestamptz(6)
  recommendation    hotel_pricing_recommendations @relation(fields: [recommendation_id], references: [id])

  @@index([hotel_id])
  @@index([recommendation_id])
}

model hotel_pricing_notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  org_id     String    @db.VarChar(255)
  hotel_id   String    @db.VarChar(50)
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  body       String
  metadata   Json?
  read_at    DateTime?
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([org_id, created_at(sort: Desc)])
  @@index([hotel_id])
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY: SERVICES (Hotels, Resorts, Events, Camping)
// ─────────────────────────────────────────────────────────────────────────────

/// Services - Bookable items: rooms, villas, dormitories, events, camping spots
model services {
  service_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id  String   @db.Uuid
  tenant_id    String   @db.Uuid
  name         String   @db.VarChar(255)
  type         String   @db.VarChar(50)    // room | villa | dormitory | event | camping | suite | tent-site | cabin | class | workshop | service
  description  String?
  base_price   Decimal  @db.Decimal(10, 2)
  capacity     Int      @default(1)        // total units of this type (e.g., 10 Deluxe Rooms)
  attributes   Json?                        // flexible JSONB: {ac, view, floor, amenities} or {location, duration, includes}
  image_urls   Json?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)

  businesses           businesses             @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  service_availability service_availability[]
  service_bookings     service_bookings[]
  service_holds        service_holds[]
  pricing_suggestions  pricing_suggestions[]
  pricing_history      pricing_history[]

  @@index([business_id, is_active])
  @@index([business_id, type])
  @@index([tenant_id])
}

/// Service Availability - Per-date slot tracking for each service
model service_availability {
  availability_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id      String   @db.Uuid
  business_id     String   @db.Uuid
  date            DateTime @db.Date
  total_slots     Int
  booked_slots    Int      @default(0)
  available_slots Int
  effective_price Decimal? @db.Decimal(10, 2)  // overrides base_price for this date (AI-approved surge)
  is_blocked      Boolean  @default(false)       // true = maintenance / owner hold
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  services services @relation(fields: [service_id], references: [service_id], onDelete: Cascade)

  @@unique([service_id, date])
  @@index([service_id, date])
  @@index([business_id, date])
}

/// Service Bookings - Confirmed reservations
model service_bookings {
  booking_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id       String   @db.Uuid
  business_id      String   @db.Uuid
  lead_id          String?  @db.Uuid
  customer_name    String   @db.VarChar(255)
  customer_phone   String   @db.VarChar(20)
  check_in_date    DateTime @db.Date
  check_out_date   DateTime @db.Date
  slots_booked     Int      @default(1)
  total_price      Decimal  @db.Decimal(10, 2)
  status           String   @default("pending") @db.VarChar(20)   // pending | confirmed | cancelled | completed
  payment_status   String   @default("unpaid") @db.VarChar(20)    // unpaid | paid | refunded
  special_requests String?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)

  services       services        @relation(fields: [service_id], references: [service_id])
  booking_guests booking_guests?

  @@index([business_id, status])
  @@index([service_id, check_in_date])
  @@index([business_id, check_in_date])
}

model booking_guests {
  guest_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking_id String   @unique @db.Uuid
  name       String   @db.VarChar(255)
  phone      String   @db.VarChar(20)
  age        Int?
  num_guests Int      @default(1)
  address    String?
  pin_code   String?  @db.VarChar(10)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  service_bookings service_bookings @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// DYNAMIC PRICING (AI-driven with client approval)
// ─────────────────────────────────────────────────────────────────────────────

/// Pricing Rules - Rules AI uses to detect when to suggest price changes
model pricing_rules {
  rule_id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id      String   @db.Uuid
  service_id       String?  @db.Uuid   // null = applies to all services in the business
  rule_name        String   @db.VarChar(255)
  rule_type        String   @db.VarChar(50)    // seasonal | weekend | event | occupancy
  conditions       Json                         // {date_from, date_to, days_of_week, occupancy_pct}
  adjustment_type  String   @db.VarChar(20)    // percentage | fixed
  adjustment_value Decimal  @db.Decimal(10, 2)
  priority         Int      @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  businesses businesses @relation(fields: [business_id], references: [business_id], onDelete: Cascade)

  @@index([business_id, is_active])
}

/// Pricing Suggestions - AI-generated price suggestions pending client approval
model pricing_suggestions {
  suggestion_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id     String    @db.Uuid
  service_id      String    @db.Uuid
  current_price   Decimal   @db.Decimal(10, 2)
  suggested_price Decimal   @db.Decimal(10, 2)
  reason          String                         // human-readable explanation from AI
  ai_confidence   Decimal?  @db.Decimal(3, 2)   // 0.00 to 1.00
  status          String    @default("pending") @db.VarChar(20)   // pending | approved | rejected
  valid_from      DateTime  @db.Date
  valid_to        DateTime  @db.Date
  reviewed_by     String?   @db.Uuid
  reviewed_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  services services @relation(fields: [service_id], references: [service_id], onDelete: Cascade)

  @@index([business_id, status])
  @@index([service_id])
}

/// Pricing History - Audit trail of all price changes (manual + AI-approved)
model pricing_history {
  history_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id    String   @db.Uuid
  business_id   String   @db.Uuid
  old_price     Decimal  @db.Decimal(10, 2)
  new_price     Decimal  @db.Decimal(10, 2)
  change_reason String
  changed_by    String?  @db.VarChar(50)   // user_id or 'AI'
  suggestion_id String?  @db.Uuid
  applied_at    DateTime @default(now()) @db.Timestamptz(6)

  services services @relation(fields: [service_id], references: [service_id], onDelete: Cascade)

  @@index([service_id, applied_at])
  @@index([business_id, applied_at])
}

/// Product Stock Alerts - Low stock notifications for physical products
model product_stock_alerts {
  alert_id      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id   String    @db.Uuid
  product_id    String    @db.Uuid
  variant_id    String?   @db.Uuid
  product_name  String    @db.VarChar(255)
  variant_name  String?   @db.VarChar(255)
  current_stock Int
  threshold     Int
  status        String    @default("active") @db.VarChar(20)   // active | acknowledged | resolved
  acknowledged_at DateTime? @db.Timestamptz(6)
  resolved_at   DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)

  businesses businesses      @relation(fields: [business_id], references: [business_id], onDelete: Cascade)
  products   products        @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  variants   product_variants? @relation(fields: [variant_id], references: [variant_id])

  @@unique([product_id, variant_id, status], map: "unique_active_alert_per_item")
  @@index([business_id, status])
  @@index([product_id])
}

/// Service Holds - Temporary slot reservation during checkout (released if payment not made)
model service_holds {
  hold_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_id     String   @db.Uuid
  business_id    String   @db.Uuid
  lead_id        String?  @db.Uuid
  check_in_date  DateTime @db.Date
  check_out_date DateTime @db.Date
  slots_held     Int      @default(1)
  status         String   @default("active") @db.VarChar(20)  // active | released | converted
  expires_at     DateTime @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  services services @relation(fields: [service_id], references: [service_id], onDelete: Cascade)

  @@index([service_id, status])
  @@index([expires_at])
  @@index([business_id, status])
}
