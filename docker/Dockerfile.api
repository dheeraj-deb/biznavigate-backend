# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx nx build api --prod

# Copy Prisma generated client (postbuild step)
RUN node -e "\
  const fs=require('fs'), path=require('path'); \
  const src=path.join('generated','prisma'); \
  const dest=path.join('dist','apps','api','generated','prisma'); \
  if(fs.existsSync(src)){fs.mkdirSync(dest,{recursive:true});fs.cpSync(src,dest,{recursive:true});} \
"

# ── Stage 2: Runtime ───────────────────────────────────────────────────────────
FROM node:20-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev --legacy-peer-deps

COPY --from=builder /app/dist/apps/api ./dist/apps/api
COPY --from=builder /app/generated ./generated
COPY prisma ./prisma

EXPOSE 3000

CMD ["node", "-r", "tsconfig-paths/register", "dist/apps/api/main.js"]
